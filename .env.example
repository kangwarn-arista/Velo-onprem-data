# VCO On-Prem API Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# VCO portal URL (must end with /portal/)
VCO_URL=https://your-vco-host.example.com/portal/

# VCO API token (can be provided with or without the "Token " prefix)
VCO_TOKEN=your-api-token-here
